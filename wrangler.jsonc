{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgi-cctv-service-desk",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}